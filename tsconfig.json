{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "firefox-webext-browser"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "wxt.config.ts"]
}
